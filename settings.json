// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "base_keymap": "Zed",
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },
  "theme_overrides": {
    "Catppuccin Mocha": {
      "hint": "#94E2D5",
    },
  },
  "cursor_animation": {
    "enabled": true,
  },
  "vim_mode": true,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 12.5,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 15,
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
  },
  "colorize_brackets": true,
  // Indentation, rainbow indentation
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  // Active pane styling settings.
  "active_pane_modifiers": {
    // Inset border size of the active pane, in pixels.
    "border_size": 2.0,
    // Opacity of the inactive panes. 0 means transparent, 1 means opaque.
    "inactive_opacity": 1.0,
  },
  // Lines to keep above/below the cursor when scrolling with the keyboard
  "vertical_scroll_margin": 7,
  "relative_line_numbers": "enabled",
  "format_on_save": "on",
  "completion_menu_item_kind": "symbol",
  "diff_view_style": "unified",
  "sticky_scroll": {
    "enabled": true,
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 0,
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "tabs": {
    "file_icons": true,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "project_panel": {
    "dock": "right",
    "diagnostic_badges": true,
    "git_status_indicator": true,
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
    "file_icons": true,
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true,
    },
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-6-luna",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-6-astra",
        "enable_thinking": true,
        "effort": "high",
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-6.1-sol",
        "enable_thinking": true,
        "effort": "low",
      },
    ],
    "dock": "left",
    "default_profile": "write",
    "model_parameters": [],
    "single_file_review": true,
    "auto_compact": {
      "enabled": true,
      "threshold": "90%",
    },
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6-luna",
      "enable_thinking": true,
      "effort": "high",
    },
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": true,
    },
    "commit_message_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6-luna",
      "enable_thinking": true,
      "effort": "medium",
    },
    "commit_message_include_project_rules": false,
    "commit_message_instructions": "Review the current Git staged changes and produce one or more clear, high-quality commit message(s) for those changes.\n\nRequired steps:\n- Inspect staged files and diffs (e.g. run `git diff --staged --name-only` and `git diff --staged`).\n- Group changes into logical commits. If changes are unrelated, produce multiple commit messages (one per logical change). If they belong together, produce a single commit message.\n- Follow the Conventional Commits format for each message:\n  - Header: type(scope?): short summary\n    - type: feat, fix, docs, style, refactor, perf, test, chore, ci, build\n    - Keep the subject in imperative mood, <= 50 characters, no trailing period.\n  - Body (optional): explain what changed and why. Wrap at ~72 characters.\n  - Footer (optional): include `BREAKING CHANGE:` or issue references like `Fixes #123`.\n\nOutput rules:\n- If a single commit is appropriate: output ONLY the commit message text (header, blank line, body, optional footer). Do NOT include file lists, diff excerpts, or extra commentary.\n- If multiple commits are appropriate: output each commit message separated by a single line containing three hyphens (`---`). Each commit must follow the format above. Do NOT include extra commentary.\n- If context is unclear: include a one-line note beginning with `NOTE:` describing what you couldn't determine, followed by the commit message(s).\n\nExamples:\n\nfeat(auth): add token refresh on 401\nAutomatically refresh auth tokens when a 401 response is received to\nprevent repeated failed requests and improve user experience.\nFixes #42\n\n---\n\nfix(api): validate response before accessing properties\nEnsure the API handler checks for null/undefined responses before\naccessing properties to avoid runtime exceptions in edge cases.\n\nWhen ready, inspect the staged changes and generate the commit message(s) following the rules above.",
    "compaction_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6-luna",
      "enable_thinking": true,
      "effort": "high",
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "always_deny": [{ "pattern": "git\\s+(add|commit)" }],
          "always_allow": [
            { "pattern": "find" },
            { "pattern": "git\\s+(diff|log|status)" },
            { "pattern": "go\\s+(build|test|vet)" },
            { "pattern": "gofmt" },
            { "pattern": "grep" },
            { "pattern": "rg" },
            { "pattern": "sed" },
          ],
        },
      },
    },
    "profiles": {
      "write": {
        "name": "Write",
        "enable_all_context_servers": true,
        "tools": {
          "copy_path": true,
          "create_directory": true,
          "create_thread": true,
          "delete_path": true,
          "diagnostics": true,
          "apply_code_action": true,
          "ask_user": true,
          "edit_file": true,
          "write_file": true,
          "fetch": true,
          "find_path": true,
          "find_references": true,
          "get_code_actions": true,
          "go_to_definition": true,
          "list_agents_and_models": true,
          "list_directory": true,
          "move_path": true,
          "rename_symbol": true,
          "read_file": true,
          "grep": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": true,
          "search_web": true,
        },
      },
    },
  },
  "context_servers": {
    "codebase-memory-mcp": {
      "command": "/Users/fepozopo/.local/bin/codebase-memory-mcp",
      "args": [""],
    },
  },
  "agent_servers": {},
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
  },
  "auto_install_extensions": {
    "html": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "comment": true,
    "lua": true,
    "sql": true,
    "odin": true,
    "zig": true,
    "vue": true,
    "make": true,
    "git-firefly": true,
    "rainbow-csv": true,
    "toml": true,
    "gosum": true,
    "dockerfile": true,
    "docker-compose": true,
    "golangci-lint": true,
  },
  "inlay_hints": {
    "enabled": false,
  },
  "inline_code_actions": true,
  "code_lens": "menu",
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 8,
      "min_column": 0,
      "max_severity": "all",
    },
  },
  "languages": {
    "Go": {
      "language_servers": ["gopls"],
      "formatter": ["language_server"],
    },
    "Python": {
      "language_servers": [
        "ty",
        "ruff",
        "!basedpyright",
        "!pyrefly",
        "!pyright",
        "!pylsp",
      ],
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
    },
  },
  "lsp": {},
}
